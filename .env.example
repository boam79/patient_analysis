# 병원 CRM v4.6 - Environment Variables Template
# Copy this file to .env.local for development
# Copy this file to .env.production for production

# ====================
# Next.js Configuration
# ====================
NEXT_TELEMETRY_DISABLED=1

# ====================
# OpenStreetMap Nominatim API
# ====================
NOMINATIM_API_URL=https://nominatim.openstreetmap.org/search
NOMINATIM_USER_AGENT=Hospital-CRM/1.0

# ====================
# Supabase (인증, 제작자/admin 페이지, IP 로그, 감사 로그 등에서 사용)
# 실제 인증은 Supabase Auth로 처리되며, 아래 값이 없으면 빌드/미들웨어가 실패합니다.
# (v4.6부터 NextAuth + Prisma + PostgreSQL 스택은 완전히 제거되었습니다)
# ====================
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Service Role Key는 서버 전용 (RLS 우회). 클라이언트에 노출 금지.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ====================
# 시스템 이상탐지 알림 (선택 사항)
# 설정하지 않으면 크론 잡이 이상탐지는 수행하되 알림 전송은 스킵합니다.
# ====================
# Slack Incoming Webhook URL (https://api.slack.com/messaging/webhooks)
SLACK_WEBHOOK_URL=
# Vercel Cron 인증용 시크릿 (설정 시 /api/cron/* 라우트가 Authorization 헤더를 검증)
CRON_SECRET=
